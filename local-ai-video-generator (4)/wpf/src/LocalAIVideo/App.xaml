<Application x:Class="LocalAIVideo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <!-- ===== converters & effects ===== -->
      <BooleanToVisibilityConverter x:Key="BoolToVis"/>
      <DropShadowEffect x:Key="GlowEffect" Color="#10B981" BlurRadius="34" ShadowDepth="0" Opacity="0.28"/>

      <Style x:Key="ProgressBarDark" TargetType="ProgressBar">
        <Setter Property="Height" Value="10"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Background" Value="#1c1c21"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ProgressBar">
              <Grid>
                <Border CornerRadius="5" Background="{TemplateBinding Background}"/>
                <Border x:Name="PART_Track" CornerRadius="5" Margin="0"/>
                <Border x:Name="PART_Indicator" CornerRadius="5" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"/>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ===== Dark design language (kept in sync with the original UI) ===== -->
      <SolidColorBrush x:Key="BgBrush" Color="#09090B"/>
      <SolidColorBrush x:Key="PanelBrush" Color="#0C0C0F"/>
      <SolidColorBrush x:Key="CardBrush" Color="#141417"/>
      <SolidColorBrush x:Key="CardHoverBrush" Color="#1C1C21"/>
      <SolidColorBrush x:Key="LineBrush" Color="#26262C"/>
      <SolidColorBrush x:Key="AccentBrush" Color="#10B981"/>
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#34D399"/>
      <SolidColorBrush x:Key="TextBrush" Color="#E4E4E7"/>
      <SolidColorBrush x:Key="DimBrush" Color="#8B8B93"/>
      <SolidColorBrush x:Key="DimmerBrush" Color="#5B5B63"/>
      <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
      <SolidColorBrush x:Key="WarnBrush" Color="#F59E0B"/>
      <SolidColorBrush x:Key="InfoBrush" Color="#38BDF8"/>

      <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
      </Style>

      <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
        <Setter Property="Margin" Value="0,0,0,3"/>
      </Style>

      <Style x:Key="TextBoxDark" TargetType="TextBox">
        <Setter Property="Background" Value="#0C0C0F"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="7,5"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
      </Style>

      <Style x:Key="ComboBoxDark" TargetType="ComboBox">
        <Setter Property="Background" Value="#0C0C0F"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="7,5"/>
        <Setter Property="FontSize" Value="12"/>
      </Style>

      <Style x:Key="BtnBase" TargetType="Button">
        <Setter Property="Background" Value="#141417"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="b" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="4" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="b" Property="Background" Value="#1C1C21"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Foreground" Value="#04150F"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="b" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="#2A0E0E"/>
        <Setter Property="Foreground" Value="#FCA5A5"/>
        <Setter Property="BorderBrush" Value="#7F1D1D"/>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
