<Window x:Class="LocalAIVideo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Local AI Video — Native WPF" Height="860" Width="1360"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="52"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="88"/>
    </Grid.RowDefinitions>

    <!-- ================= TOP BAR ================= -->
    <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="16,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="6" Background="{StaticResource AccentBrush}" VerticalAlignment="Center">
          <TextBlock Text="▶" Foreground="#04150F" FontWeight="Black" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Grid.Column="1" Text="LOCAL AI VIDEO" Foreground="{StaticResource TextBrush}" FontWeight="Bold" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"/>

        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
          <Border Background="{StaticResource CardBrush}" CornerRadius="5" Padding="10,4" Margin="0,0,10,0">
            <TextBlock Foreground="{StaticResource DimBrush}" FontSize="11" MaxWidth="320" TextTrimming="CharacterEllipsis" Text="{Binding Status}"/>
          </Border>
          <Border Background="{StaticResource CardBrush}" CornerRadius="5" Padding="10,4" Margin="0,0,10,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding ProgressStage}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <ProgressBar Style="{StaticResource ProgressBarDark}" Maximum="1" Height="8" Width="90" Value="{Binding Progress, Mode=OneWay}" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="DURDUR" Style="{StaticResource BtnDanger}" Command="{Binding CancelCommand}" Margin="0,0,10,0"/>
          <Button Content="GENERATE VIDEO" Style="{StaticResource BtnPrimary}" FontSize="12" Padding="18,8" Command="{Binding GenerateCommand}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ================= MAIN ================= -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="288"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="300"/>
      </Grid.ColumnDefinitions>

      <!-- LEFT: settings -->
      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14">
          <StackPanel>
            <TextBlock Text="CREATE VIDEO" Style="{StaticResource SectionTitle}"/>

            <TextBlock Text="Topic" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Topic, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxDark}" Height="64" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

            <TextBlock Text="Duration" Style="{StaticResource FieldLabel}" Margin="0,12,0,3"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0" Content="30s" Style="{StaticResource BtnBase}" Margin="0,0,4,0" Click="Preset_Click" Tag="30"/>
              <Button Grid.Column="1" Content="60s" Style="{StaticResource BtnBase}" Margin="4,0,4,0" Click="Preset_Click" Tag="60"/>
              <Button Grid.Column="2" Content="5m"  Style="{StaticResource BtnBase}" Margin="4,0,4,0" Click="Preset_Click" Tag="300"/>
              <Button Grid.Column="3" Content="10m" Style="{StaticResource BtnBase}" Click="Preset_Click" Tag="600"/>
            </Grid>
            <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource DimBrush}"
                       Text="{Binding DurationSec, StringFormat={}{0:0}s — custom via duration field}"/>

            <TextBlock Text="Aspect Ratio" Style="{StaticResource FieldLabel}" Margin="0,12,0,3"/>
            <ComboBox ItemsSource="{Binding Aspects}" SelectedItem="{Binding Aspect}" Style="{StaticResource ComboBoxDark}"/>

            <TextBlock Text="Language" Style="{StaticResource FieldLabel}" Margin="0,12,0,3"/>
            <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" Style="{StaticResource ComboBoxDark}"/>

            <TextBlock Text="Quality" Style="{StaticResource FieldLabel}" Margin="0,12,0,3"/>
            <ComboBox ItemsSource="{Binding Qualities}" SelectedItem="{Binding Quality}" Style="{StaticResource ComboBoxDark}"/>

            <TextBlock Text="Character" Style="{StaticResource FieldLabel}" Margin="0,12,0,3"/>
            <ComboBox ItemsSource="{Binding CharModes}" SelectedItem="{Binding CharMode}" Style="{StaticResource ComboBoxDark}"/>

            <TextBlock Text="LLM Model (Ollama · localhost)" Style="{StaticResource FieldLabel}" Margin="0,12,0,3"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ComboBox Grid.Column="0" ItemsSource="{Binding Models}" DisplayMemberPath="Name" SelectedValuePath="Name"
                        SelectedValue="{Binding LlmModel}" Style="{StaticResource ComboBoxDark}"/>
              <Button Grid.Column="1" Content="⟳" Style="{StaticResource BtnBase}" Margin="6,0,0,0" Command="{Binding LoadModelsCommand}"/>
            </Grid>

            <TextBlock Text="TTS Voice (System.Speech)" Style="{StaticResource FieldLabel}" Margin="0,12,0,3"/>
            <ComboBox ItemsSource="{Binding Voices}" DisplayMemberPath="Name" SelectedValuePath="Id"
                      SelectedValue="{Binding TtsVoice}" Style="{StaticResource ComboBoxDark}"/>

            <TextBlock Text="TTS Speed" Style="{StaticResource FieldLabel}" Margin="0,12,0,3"/>
            <Slider Minimum="0.6" Maximum="1.5" Value="{Binding TtsSpeed}" TickFrequency="0.1" IsSnapToTickEnabled="True"/>

            <TextBlock Text="Master Seed" Style="{StaticResource FieldLabel}" Margin="0,12,0,3"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" Text="{Binding MasterSeed}" Style="{StaticResource TextBoxDark}"/>
              <Button Grid.Column="1" Content="🎲" Style="{StaticResource BtnBase}" Margin="6,0,0,0" Command="{Binding NewSeedCommand}"/>
            </Grid>

            <Grid Margin="0,12,0,0">
              <CheckBox IsChecked="{Binding Captions}" Content="Captions" Foreground="{StaticResource TextBrush}" FontSize="12" VerticalContentAlignment="Center"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Chunk" Foreground="{StaticResource DimBrush}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <ComboBox Width="70" ItemsSource="{Binding ChunkOptions}" SelectedItem="{Binding ChunkSeconds}" Style="{StaticResource ComboBoxDark}"/>
              </StackPanel>
            </Grid>

            <Border Margin="0,16,0,0" Background="{StaticResource CardBrush}" CornerRadius="6" Padding="10,8">
              <StackPanel>
                <TextBlock Text="DEVICE" Style="{StaticResource SectionTitle}"/>
                <TextBlock FontSize="11" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis">
                  <Run Text="GPU:"/><Run Text="{Binding Device.GpuDescription, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock FontSize="11" Foreground="{StaticResource DimBrush}">
                  <Run Text="RAM:"/><Run Text="{Binding Device.TotalMemoryGB, StringFormat={}{0:0.0} GB, Mode=OneWay}"/>
                  <Run Text="  ·  VRAM est:"/><Run Text="{Binding Device.EstimatedVramGB, StringFormat={}{0:0.0} GB, Mode=OneWay}"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                  <Border Background="{StaticResource AccentBrush}" CornerRadius="4" Padding="8,2">
                    <TextBlock Text="{Binding Device.Tier, Mode=OneWay}" Foreground="#04150F" FontWeight="Bold" FontSize="11"/>
                  </Border>
                  <Button Content="Detect" Style="{StaticResource BtnBase}" Margin="10,0,0,0" Padding="8,2" Command="{Binding RefreshHardwareCommand}"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- CENTER: preview -->
      <Grid Grid.Column="1" Background="#0B0B0E">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
          <Grid Margin="16">
            <Image Source="{Binding Preview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                   MaxWidth="560" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Effect="{StaticResource GlowEffect}"/>
          </Grid>
        </Border>
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" Padding="16,10">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Vertical">
              <TextBlock Text="LIVE PREVIEW — Procedural 2D Scene Engine" Foreground="{StaticResource DimBrush}" FontSize="11"/>
              <TextBlock Text="{Binding OutputPath}" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,3,0,0"
                         TextTrimming="CharacterEllipsis" MaxWidth="560"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="▶ Play / ❚❚" Style="{StaticResource BtnBase}" Command="{Binding PlayPauseCommand}" Margin="0,0,8,0"/>
              <Button Content="Open output" Style="{StaticResource BtnPrimary}" Command="{Binding OpenOutputCommand}"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <!-- RIGHT: scenes -->
      <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="16,14,16,0">
            <TextBlock Text="SCENES" Style="{StaticResource SectionTitle}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <Border Background="{StaticResource CardBrush}" CornerRadius="5" Padding="10,5" Margin="0,0,8,0">
                <TextBlock Foreground="{StaticResource DimBrush}" FontSize="11">
                  <Run Text="LLM:"/><Run Text="{Binding LlmModel, Mode=OneWay}" Foreground="{StaticResource TextBrush}"/>
                </TextBlock>
              </Border>
              <Border Background="{StaticResource CardBrush}" CornerRadius="5" Padding="10,5">
                <TextBlock Foreground="{StaticResource DimBrush}" FontSize="11">
                  <Run Text="TTS:"/><Run Text="{Binding TtsVoice, Mode=OneWay}" Foreground="{StaticResource TextBrush}"/>
                </TextBlock>
              </Border>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Row="1" Margin="16,0,16,0">
            <TextBlock Text="PROJECTS" Style="{StaticResource SectionTitle}"/>
            <ItemsControl ItemsSource="{Binding Projects}" MaxHeight="120" Margin="0,0,0,8">
              <ItemsControl.Template>
                <ControlTemplate>
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </ControlTemplate>
              </ItemsControl.Template>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Foreground="{StaticResource DimmerBrush}" FontSize="10">
                        <Run Text="{Binding Scenes, Mode=OneWay}"/><Run Text=" scenes · "/><Run Text="{Binding UpdatedAt, StringFormat={}{0:HH:mm}, Mode=OneWay}"/>
                      </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Open" Style="{StaticResource BtnBase}" Padding="8,2" Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                    <Button Grid.Column="2" Content="✕" Style="{StaticResource BtnDanger}" Padding="8,2" Margin="4,0,0,0" Command="{Binding DataContext.DeleteProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <Border Grid.Row="2" Margin="16,0,16,16" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Text="SCENE PLAN" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
              <ItemsControl Grid.Row="1" ItemsSource="{Binding Scenes}">
                <ItemsControl.Template>
                  <ControlTemplate>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                      <ItemsPresenter/>
                    </ScrollViewer>
                  </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,0,6" CornerRadius="6" Background="{StaticResource CardBrush}" Padding="10,8"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Cursor="Hand"
                            MouseLeftButtonUp="SceneRow_Click">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                              <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <StackPanel>
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0" Text="{Binding SceneId, StringFormat=Scene {0:D2}}" Foreground="{StaticResource TextBrush}" FontWeight="Bold" FontSize="11"/>
                          <TextBlock Grid.Column="1" Text="{Binding TtsStatus}" Foreground="{StaticResource DimBrush}" FontSize="10" VerticalAlignment="Center" Margin="8,0,8,0"/>
                          <TextBlock Grid.Column="2" Text="{Binding Duration, StringFormat={}{0:0.0}s}" Foreground="{StaticResource DimBrush}" FontSize="10" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{Binding Voiceover}" Foreground="{StaticResource DimBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <TextBlock Foreground="{StaticResource DimmerBrush}" FontSize="10" Margin="0,4,0,0">
                          <Run Text="{Binding Env, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Emotion, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Camera, Mode=OneWay}"/>
                        </TextBlock>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <!-- ================= BOTTOM: pipeline timeline ================= -->
    <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
      <Grid Margin="16,10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
          <Border Background="{StaticResource CardBrush}" CornerRadius="4" Padding="8,3" Margin="0,0,6,0"><TextBlock Text="SCRIPT" Foreground="{StaticResource DimBrush}" FontSize="10" FontWeight="SemiBold"/></Border>
          <TextBlock Text="→" Foreground="{StaticResource DimmerBrush}" FontSize="11" VerticalAlignment="Center" Margin="2,0"/>
          <Border Background="{StaticResource CardBrush}" CornerRadius="4" Padding="8,3" Margin="0,0,6,0"><TextBlock Text="TTS (sequential)" Foreground="{StaticResource DimBrush}" FontSize="10" FontWeight="SemiBold"/></Border>
          <TextBlock Text="→" Foreground="{StaticResource DimmerBrush}" FontSize="11" VerticalAlignment="Center" Margin="2,0"/>
          <Border Background="{StaticResource CardBrush}" CornerRadius="4" Padding="8,3" Margin="0,0,6,0"><TextBlock Text="AUDIO MIX" Foreground="{StaticResource DimBrush}" FontSize="10" FontWeight="SemiBold"/></Border>
          <TextBlock Text="→" Foreground="{StaticResource DimmerBrush}" FontSize="11" VerticalAlignment="Center" Margin="2,0"/>
          <Border Background="{StaticResource CardBrush}" CornerRadius="4" Padding="8,3" Margin="0,0,6,0"><TextBlock Text="FFMPEG ENCODE" Foreground="{StaticResource DimBrush}" FontSize="10" FontWeight="SemiBold"/></Border>
          <Border Background="{StaticResource AccentBrush}" CornerRadius="4" Padding="8,3" Margin="0,0,6,0"><TextBlock Text="LOCAL · NO CLOUD" Foreground="#04150F" FontSize="10" FontWeight="Bold"/></Border>
          <TextBlock Text="{Binding Status}" Foreground="{StaticResource DimBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="520"/>
        </StackPanel>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ProgressBar Grid.Column="0" Style="{StaticResource ProgressBarDark}" Maximum="1" Value="{Binding Progress, Mode=OneWay}" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="{Binding Progress, StringFormat={}{0:P0}}" Foreground="{StaticResource TextBrush}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" Width="44" TextAlignment="Right"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
